{% extends 'base.html.twig' %}

{% block title %}Staff sign in · Shan's Guitar{% endblock %}

{#
    The login page replaces the whole "layout" block from base.html.twig,
    so it has no sidebar and no admin header.
#}
{% block layout %}
<main class="grid min-h-screen place-items-center bg-ebony px-5 py-10">
    <div class="w-full max-w-md">
        <p class="text-center font-display text-5xl leading-none text-parchment">
            <span class="font-bold italic">shan<span class="text-honey">’s</span></span>
            <span class="font-light">guitar</span>
        </p>
        <p class="mt-3 text-center text-sm text-parchment/60">Admin panel</p>

        <form method="post" class="mt-8 rounded-2xl bg-parchment p-7 shadow-2xl shadow-black/40 sm:p-8">
            <h1 class="font-display text-2xl font-bold">Staff sign in</h1>
            <p class="mt-1 text-sm text-ebony/60">Use the email and password of an admin account.</p>

            {% if error %}
                <div role="alert" class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <label for="email" class="mt-6 block text-sm font-semibold">Email</label>
            <input type="email" value="{{ last_username }}" name="email" id="email"
                   autocomplete="email" required autofocus
                   class="mt-1.5 block w-full rounded-xl border border-ebony/15 bg-white/70 px-4 py-2.5 outline-none transition focus:border-honey focus:ring-2 focus:ring-honey/30">

            <label for="password" class="mt-4 block text-sm font-semibold">Password</label>
            <input type="password" name="password" id="password"
                   autocomplete="current-password" required
                   class="mt-1.5 block w-full rounded-xl border border-ebony/15 bg-white/70 px-4 py-2.5 outline-none transition focus:border-honey focus:ring-2 focus:ring-honey/30">

            <label class="mt-4 flex items-center gap-2 text-sm text-ebony/75">
                <input type="checkbox" name="_remember_me" class="h-4 w-4 rounded accent-honey">
                Keep me signed in for a week
            </label>

            {# Security token: proves the form was sent from this page #}
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button type="submit"
                    class="mt-6 w-full rounded-full bg-honey px-6 py-3 font-bold text-white transition-colors hover:bg-honey-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey">
                Sign in
            </button>
        </form>
    </div>
</main>
{% endblock %}
