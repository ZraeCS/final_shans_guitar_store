{% extends 'base.html.twig' %}

{% block title %}Admin Log In · Shan's Guitar{% endblock %}

{#
    Same look as the store's login page (cream background, rounded card,
    "Log In" heading in Fraunces), but for staff only. Customers are sent
    back to the store's own login.
    It replaces the whole "layout" block, so there's no admin sidebar here.
#}
{% block layout %}
<div class="flex min-h-screen flex-col bg-parchment">
    {# Top bar, like the store's header #}
    <header class="bg-ebony">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 sm:px-8">
            <a href="{{ store_url() }}" class="font-display text-xl leading-none text-parchment">
                <span class="font-bold">shan<span class="text-honey">’s</span> guitar</span>
            </a>
            <a href="{{ store_url() }}" class="rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-parchment ring-1 ring-parchment/30 transition-colors hover:bg-white/10">
                Back to the store
            </a>
        </div>
    </header>

    <main class="grid flex-1 place-items-center bg-[radial-gradient(ellipse_at_top,_#F5E6C8_0%,_#FDF3E0_60%)] px-5 py-12">
        <form method="post" class="w-full max-w-sm rounded-3xl border border-ebony/10 bg-[#FFFBF3] p-8 shadow-xl shadow-honey/10">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-honey-deep">Staff access</p>
            <h1 class="mt-2 font-display text-4xl font-bold leading-tight">Admin <span class="font-normal italic">Log In</span></h1>
            <p class="mt-1 text-sm text-ebony/65">Staff accounts manage inventory and orders.</p>

            <hr class="my-6 border-ebony/10">

            {% if error %}
                <div role="alert" class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <label for="email" class="block text-sm font-bold">Email address</label>
            <input type="email" value="{{ last_username }}" name="email" id="email"
                   placeholder="admin@shansguitar.com" autocomplete="email" required autofocus
                   class="mt-1.5 block w-full rounded-xl border border-ebony/15 bg-sand/40 px-4 py-2.5 text-sm outline-none transition placeholder:text-ebony/40 focus:border-honey focus:ring-2 focus:ring-honey/30">

            <label for="password" class="mt-4 block text-sm font-bold">Password</label>
            <input type="password" name="password" id="password"
                   autocomplete="current-password" required
                   class="mt-1.5 block w-full rounded-xl border border-ebony/15 bg-sand/40 px-4 py-2.5 text-sm outline-none transition focus:border-honey focus:ring-2 focus:ring-honey/30">

            <label class="mt-4 flex items-center gap-2 text-sm text-ebony/75">
                <input type="checkbox" name="_remember_me" class="h-4 w-4 accent-honey">
                Keep me signed in for a week
            </label>

            {# Security token: proves the form was sent from this page #}
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button type="submit"
                    class="mt-6 w-full rounded-full bg-honey px-6 py-3 text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-honey-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey">
                Log in as admin
            </button>

            <p class="mt-5 rounded-xl border border-ebony/10 bg-sand/40 px-4 py-3 text-xs leading-relaxed text-ebony/75">
                Staff accounts only. This opens the admin panel.
                Are you a customer? <a href="{{ store_url('auth/login.php') }}" class="font-bold text-honey-deep underline-offset-2 hover:underline">Log in on the store</a>.
            </p>
        </form>
    </main>
</div>
{% endblock %}
