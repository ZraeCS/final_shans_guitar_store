{% extends 'base.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Edit {{ guitar.name }} · Shan's Guitar Admin{% endblock %}

{% block page_title %}Edit product{% endblock %}
{% block page_subtitle %}{{ guitar.name }} · {{ guitar.itemCode }}{% endblock %}

{% block body %}
    {% set btn = 'inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey' %}

    <a href="{{ path('app_product_index') }}" class="mb-4 inline-flex items-center gap-1.5 text-sm font-semibold text-honey-deep underline-offset-4 hover:underline">
        {{ icons.icon('back', 'h-4 w-4') }} Back to Products & Stock
    </a>

    <section class="grid gap-6 lg:grid-cols-[16rem_1fr]">
        {# Current photo #}
        <div class="rounded-2xl bg-parchment p-5 ring-1 ring-ebony/10">
            <p class="text-sm font-semibold text-ebony/60">Current photo</p>
            <div class="mt-3 grid aspect-square place-items-center overflow-hidden rounded-xl bg-white ring-1 ring-ebony/10">
                {% if guitar.image %}
                    <img src="{{ store_url(guitar.image) }}" alt="{{ guitar.name }}" class="h-full w-full object-contain">
                {% else %}
                    <span class="text-ebony/30">{{ icons.icon('image', 'h-10 w-10') }}</span>
                {% endif %}
            </div>
            <p class="mt-3 break-all text-xs text-ebony/55">{{ guitar.image ?: 'No photo yet' }}</p>
        </div>

        <div class="rounded-2xl bg-parchment p-6 ring-1 ring-ebony/10 sm:p-8">
            {{ form_start(form) }}
                {{ include('product/_form_fields.html.twig') }}

                <div class="mt-6 flex justify-end gap-2">
                    <a href="{{ path('app_product_index') }}" class="{{ btn }} ring-1 ring-ebony/20 hover:bg-sand">Cancel</a>
                    <button type="submit" class="{{ btn }} bg-honey text-white hover:bg-honey-deep">Save changes</button>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
