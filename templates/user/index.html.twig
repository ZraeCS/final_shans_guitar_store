{% extends 'base.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Users · Shan's Guitar Admin{% endblock %}

{% block page_title %}Users{% endblock %}
{% block page_subtitle %}{{ counts.all }} accounts · {{ counts.admin }} admin{{ counts.admin == 1 ? '' : 's' }} · {{ counts.staff }} staff · {{ counts.user }} customers{% endblock %}

{% block body %}
    {% set chip = 'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-bold transition-colors' %}
    {% set btn = 'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey' %}
    {% set role_style = { admin: 'bg-ebony text-parchment', staff: 'bg-honey/15 text-honey-deep', user: 'bg-sky-100 text-sky-800' } %}
    {% set keep = (query ? {q: query} : {})|merge(current_status ? {status: current_status.value} : {}) %}

    <section class="rounded-2xl bg-parchment ring-1 ring-ebony/10">
        {# ---------- Filters, search, add ---------- #}
        <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-5">
            <nav aria-label="Filter by role" class="flex flex-wrap gap-2">
                <a href="{{ path('app_user_index', keep) }}" class="{{ chip }} {{ current_role is null ? 'bg-honey text-white' : 'ring-1 ring-ebony/15 hover:bg-sand' }}">All <span class="opacity-70">{{ counts.all }}</span></a>
                {% for r in roles|reverse %}
                    <a href="{{ path('app_user_index', keep|merge({role: r.value})) }}"
                       class="{{ chip }} {{ current_role == r ? 'bg-honey text-white' : 'ring-1 ring-ebony/15 hover:bg-sand' }}">
                        {{ r.label }}{{ r.value == 'staff' ? '' : 's' }} <span class="opacity-70">{{ counts[r.value] }}</span>
                    </a>
                {% endfor %}
            </nav>

            <div class="flex flex-wrap items-center gap-2">
                <form method="get" action="{{ path('app_user_index') }}" class="flex items-center gap-2">
                    {% if current_role %}<input type="hidden" name="role" value="{{ current_role.value }}">{% endif %}
                    <label class="sr-only" for="status">Status</label>
                    <select id="status" name="status" onchange="this.form.submit()" class="rounded-full border border-ebony/15 bg-white/70 px-3 py-2 text-sm outline-none focus:border-honey">
                        <option value="">Any status</option>
                        {% for st in statuses %}<option value="{{ st.value }}" {{ current_status == st ? 'selected' }}>{{ st.label }}</option>{% endfor %}
                    </select>
                    <label class="relative">
                        <span class="sr-only">Search accounts</span>
                        <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-ebony/45">{{ icons.icon('search', 'h-4 w-4') }}</span>
                        <input type="search" name="q" value="{{ query }}" placeholder="Name or email"
                               class="w-52 rounded-full border border-ebony/15 bg-white/70 py-2 pl-9 pr-4 text-sm outline-none focus:border-honey focus:ring-2 focus:ring-honey/30">
                    </label>
                </form>
                <a href="{{ path('app_register') }}" class="{{ btn }} bg-honey px-4 py-2 text-sm text-white hover:bg-honey-deep">
                    {{ icons.icon('plus', 'h-4 w-4') }} Add staff / admin
                </a>
            </div>
        </div>

        {# ---------- Accounts ---------- #}
        <div class="overflow-x-auto">
            <table class="w-full min-w-[58rem] text-left text-sm">
                <thead class="border-y border-ebony/10 text-xs font-semibold text-ebony/55">
                    <tr>
                        <th scope="col" class="px-6 py-3">Name</th>
                        <th scope="col" class="px-3 py-3">Email</th>
                        <th scope="col" class="px-3 py-3">Role</th>
                        <th scope="col" class="px-3 py-3">Status</th>
                        <th scope="col" class="px-3 py-3">Date created</th>
                        <th scope="col" class="px-6 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ebony/10">
                    {% for u in users %}
                        {% set me = u.id == app.user.id %}
                        <tr class="{{ u.active ? '' : 'bg-ebony/[0.03] text-ebony/60' }}">
                            <td class="px-6 py-3">
                                <div class="flex items-center gap-3">
                                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full {{ u.admin ? 'bg-ebony text-parchment' : 'bg-sand text-honey-deep' }} font-display text-sm font-bold">{{ u.initial }}</span>
                                    <span class="font-semibold">{{ u.name }}{% if me %} <span class="text-xs text-honey-deep">(you)</span>{% endif %}</span>
                                </div>
                            </td>
                            <td class="px-3 py-3">{{ u.email }}</td>
                            <td class="px-3 py-3"><span class="rounded-full px-2.5 py-1 text-xs font-bold {{ role_style[u.role.value] }}">{{ u.role.label }}</span></td>
                            <td class="px-3 py-3">
                                <span class="rounded-full px-2.5 py-1 text-xs font-bold {{ u.active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">{{ u.status.label }}</span>
                            </td>
                            <td class="px-3 py-3 text-ebony/70">{{ u.createdAt|date('M j, Y') }}</td>
                            <td class="px-6 py-3">
                                <div class="flex justify-end gap-2 whitespace-nowrap">
                                    <a href="{{ path('app_user_edit', {id: u.id}) }}" class="{{ btn }} ring-1 ring-ebony/20 hover:bg-sand">Edit</a>
                                    {% if not me %}
                                        <form method="post" action="{{ path('app_user_status', {id: u.id}) }}"
                                              onsubmit="return confirm('{{ u.active ? 'Disable' : 'Enable' }} the account of {{ u.name|e('js') }}?{{ u.active ? '\\n\\nThey will be logged out and can no longer sign in. Their orders and records stay.' : '' }}');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('user' ~ u.id) }}">
                                            <button type="submit" class="{{ btn }} ring-1 ring-ebony/20 hover:bg-sand">{{ u.active ? 'Disable' : 'Enable' }}</button>
                                        </form>
                                        <form method="post" action="{{ path('app_user_delete', {id: u.id}) }}"
                                              onsubmit="return confirm('Delete the account of {{ u.name|e('js') }}?\n\nThis can’t be undone. Products they added and payments they verified stay.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-user' ~ u.id) }}">
                                            <button type="submit" aria-label="Delete {{ u.name }}" class="{{ btn }} text-red-700 ring-1 ring-red-200 hover:bg-red-50">Delete</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="px-6 py-10 text-center text-ebony/60">No account matches this filter. <a href="{{ path('app_user_index') }}" class="font-semibold text-honey-deep underline">Show all accounts</a></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
