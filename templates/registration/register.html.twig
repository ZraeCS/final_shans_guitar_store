{% extends 'base.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Add staff account · Shan's Guitar Admin{% endblock %}

{% block page_title %}Add staff account{% endblock %}
{% block page_subtitle %}The new person can log in to this admin panel{% endblock %}

{% block body %}
    {% set input = 'mt-1.5 block w-full rounded-xl border border-ebony/15 bg-white/70 px-3.5 py-2.5 text-sm outline-none transition focus:border-honey focus:ring-2 focus:ring-honey/30' %}
    {% set label = 'block text-sm font-semibold' %}
    {% set error = 'mt-1 text-xs font-semibold text-red-700' %}
    {% set btn = 'inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey' %}

    <a href="{{ path('app_settings') }}" class="mb-4 inline-flex items-center gap-1.5 text-sm font-semibold text-honey-deep underline-offset-4 hover:underline">
        {{ icons.icon('back', 'h-4 w-4') }} Back to Settings
    </a>

    <section class="max-w-2xl rounded-2xl bg-parchment p-6 ring-1 ring-ebony/10 sm:p-8">
        <p class="text-sm text-ebony/70">
            Staff accounts are for people who work at Shan’s Guitar. They can manage products,
            orders and GCash payments. Customers don’t need this: they sign up on the store.
        </p>

        {{ form_start(registrationForm, {'attr': {'class': 'mt-6'}}) }}
            {{ form_errors(registrationForm) }}

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="sm:col-span-2">
                    {{ form_label(registrationForm.name, 'Full name', {'label_attr': {'class': label}}) }}
                    {{ form_widget(registrationForm.name, {'attr': {'class': input, 'placeholder': 'e.g. Juan Dela Cruz'}}) }}
                    <div class="{{ error }}">{{ form_errors(registrationForm.name) }}</div>
                </div>

                <div>
                    {{ form_label(registrationForm.email, 'Email (used to log in)', {'label_attr': {'class': label}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': input, 'placeholder': 'name@shansguitar.com'}}) }}
                    <div class="{{ error }}">{{ form_errors(registrationForm.email) }}</div>
                </div>

                <div>
                    {{ form_label(registrationForm.phone, 'Phone (optional)', {'label_attr': {'class': label}}) }}
                    {{ form_widget(registrationForm.phone, {'attr': {'class': input, 'placeholder': '09XX XXX XXXX'}}) }}
                    <div class="{{ error }}">{{ form_errors(registrationForm.phone) }}</div>
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword.first, 'Password', {'label_attr': {'class': label}}) }}
                    {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': input, 'placeholder': 'At least 8 characters'}}) }}
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword.second, 'Repeat password', {'label_attr': {'class': label}}) }}
                    {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': input}}) }}
                </div>
                <div class="{{ error }} sm:col-span-2 -mt-3">{{ form_errors(registrationForm.plainPassword) }}{{ form_errors(registrationForm.plainPassword.first) }}</div>

                <div class="sm:col-span-2">
                    <label class="flex items-start gap-2 text-sm">
                        {{ form_widget(registrationForm.confirmStaff, {'attr': {'class': 'mt-0.5 h-4 w-4 accent-honey'}}) }}
                        <span>I confirm this person works at Shan’s Guitar and should have full access to the admin panel.</span>
                    </label>
                    <div class="{{ error }}">{{ form_errors(registrationForm.confirmStaff) }}</div>
                </div>
            </div>

            {{ form_rest(registrationForm) }}

            <div class="mt-6 flex justify-end gap-2">
                <a href="{{ path('app_settings') }}" class="{{ btn }} ring-1 ring-ebony/20 hover:bg-sand">Cancel</a>
                <button type="submit" class="{{ btn }} bg-honey text-white hover:bg-honey-deep">Create staff account</button>
            </div>
        {{ form_end(registrationForm) }}
    </section>
{% endblock %}
