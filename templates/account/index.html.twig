{% extends 'base.html.twig' %}

{% block title %}My account · Shan's Guitar Admin{% endblock %}

{% block page_title %}My account{% endblock %}
{% block page_subtitle %}Your profile and password{% endblock %}

{% block body %}
    {% set me = app.user %}
    {% set input = 'mt-1.5 block w-full rounded-xl border border-ebony/15 bg-white/70 px-3.5 py-2.5 text-sm outline-none transition focus:border-honey focus:ring-2 focus:ring-honey/30' %}
    {% set label = 'block text-sm font-semibold' %}
    {% set error = 'mt-1 text-xs font-semibold text-red-700' %}

    <div class="grid gap-6 xl:grid-cols-2">
        {# ---------- Profile ---------- #}
        <section class="rounded-2xl bg-parchment p-6 ring-1 ring-ebony/10 sm:p-8">
            <div class="flex items-center gap-4">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-honey font-display text-2xl font-bold text-white">{{ me.initial }}</span>
                <div>
                    <h2 class="font-display text-2xl font-bold">{{ me.name }}</h2>
                    <p class="text-sm text-ebony/60">{{ me.role.label }} · {{ me.status.label }}</p>
                </div>
            </div>
            <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
                <div><dt class="text-xs font-semibold text-ebony/55">Email (used to log in)</dt><dd class="mt-0.5 font-medium">{{ me.email }}</dd></div>
                <div><dt class="text-xs font-semibold text-ebony/55">Phone</dt><dd class="mt-0.5 font-medium">{{ me.phone ?? '—' }}</dd></div>
                <div><dt class="text-xs font-semibold text-ebony/55">Role</dt><dd class="mt-0.5 font-medium">{{ me.role.label }}</dd></div>
                <div><dt class="text-xs font-semibold text-ebony/55">Member since</dt><dd class="mt-0.5 font-medium">{{ me.createdAt|date('F j, Y') }}</dd></div>
                <div><dt class="text-xs font-semibold text-ebony/55">Products you added</dt><dd class="mt-0.5 font-display text-2xl font-bold">{{ products_added }}</dd></div>
                <div><dt class="text-xs font-semibold text-ebony/55">GCash payments you verified</dt><dd class="mt-0.5 font-display text-2xl font-bold">{{ payments_verified }}</dd></div>
            </dl>
            <p class="mt-6 text-xs text-ebony/55">
                {% if is_granted('ROLE_ADMIN') %}
                    As an admin you can change your name or email on the <a href="{{ path('app_user_edit', {id: me.id}) }}" class="font-semibold text-honey-deep underline">Users page</a>.
                {% else %}
                    To change your name, email or role, ask an administrator.
                {% endif %}
            </p>
        </section>

        {# ---------- Change your password ---------- #}
        <section class="rounded-2xl bg-parchment p-6 ring-1 ring-ebony/10 sm:p-8">
            <h2 class="font-display text-xl font-bold">Change your password</h2>
            <p class="mt-1 text-sm text-ebony/60">You stay signed in after changing it.</p>

            {{ form_start(passwordForm, {'attr': {'class': 'mt-5 space-y-4'}}) }}
                <div>
                    {{ form_label(passwordForm.currentPassword, 'Current password', {'label_attr': {'class': label}}) }}
                    {{ form_widget(passwordForm.currentPassword, {'attr': {'class': input}}) }}
                    <div class="{{ error }}">{{ form_errors(passwordForm.currentPassword) }}</div>
                </div>
                <div>
                    {{ form_label(passwordForm.newPassword.first, 'New password', {'label_attr': {'class': label}}) }}
                    {{ form_widget(passwordForm.newPassword.first, {'attr': {'class': input, 'placeholder': 'At least 8 characters'}}) }}
                </div>
                <div>
                    {{ form_label(passwordForm.newPassword.second, 'Repeat new password', {'label_attr': {'class': label}}) }}
                    {{ form_widget(passwordForm.newPassword.second, {'attr': {'class': input}}) }}
                    <div class="{{ error }}">{{ form_errors(passwordForm.newPassword) }}{{ form_errors(passwordForm.newPassword.first) }}</div>
                </div>
                {{ form_rest(passwordForm) }}
                <div class="flex justify-end">
                    <button type="submit" class="inline-flex items-center rounded-full bg-honey px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-honey-deep">Update password</button>
                </div>
            {{ form_end(passwordForm) }}
        </section>
    </div>
{% endblock %}
