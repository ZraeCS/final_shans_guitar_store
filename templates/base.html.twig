<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Shan's Guitar Admin{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎸</text></svg>">

        {# Fonts: Fraunces (headings) and Outfit (text), the same as the store website #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,700;1,9..144,700&family=Outfit:wght@400;500;600;700;900&display=swap" rel="stylesheet">

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    {#
        data-turbo="false": every click is a normal page load. Simpler and more
        predictable for popups and messages than Turbo's partial page swaps.
    #}
    <body class="bg-sand font-sans text-ebony antialiased" data-turbo="false">
        {#
            The "layout" block holds the admin frame (sidebar + page header).
            Pages that must NOT show the sidebar, like the login page later,
            replace this whole block.
        #}
        {% block layout %}
            <div class="min-h-screen lg:flex">
                {% include 'partials/sidebar.html.twig' %}

                <main class="min-w-0 flex-1 px-5 py-6 sm:px-8 lg:px-10 lg:py-8">
                    <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
                        <div>
                            <h1 class="font-display text-3xl font-bold leading-tight sm:text-4xl">
                                {% block page_title %}Dashboard{% endblock %}
                            </h1>
                            <p class="mt-1 text-sm text-ebony/60">{% block page_subtitle %}{% endblock %}</p>
                        </div>

                        {# The admin who is signed in (app.user = the logged-in User entity) #}
                        {% if app.user %}
                            <a href="{{ path('app_account') }}" class="flex items-center gap-3 rounded-full bg-parchment py-1.5 pl-1.5 pr-3 ring-1 ring-ebony/10 hover:ring-honey/50">
                                <span class="grid h-8 w-8 place-items-center rounded-full bg-honey font-display text-sm font-bold text-white">{{ app.user.initial }}</span>
                                <span class="text-sm font-semibold">{{ app.user.name }}</span>
                                <span class="rounded-full bg-sand px-2 py-0.5 text-[11px] font-bold text-honey-deep">{{ app.user.role.label }}</span>
                            </a>
                        {% endif %}
                    </header>

                    {# Messages from addFlash() in controllers ("Martin D-28 was updated.") #}
                    {% for type, messages in app.flashes(['success', 'error']) %}
                        {% for message in messages %}
                            <div role="{{ type == 'error' ? 'alert' : 'status' }}"
                                 class="mb-5 rounded-2xl border px-5 py-3 text-sm font-medium {{ type == 'error' ? 'border-red-200 bg-red-50 text-red-800' : 'border-green-200 bg-green-50 text-green-800' }}">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </main>
            </div>
        {% endblock %}
    </body>
</html>
