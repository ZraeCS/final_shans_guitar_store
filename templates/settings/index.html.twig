{% extends 'base.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Settings · Shan's Guitar Admin{% endblock %}

{% block page_title %}Settings{% endblock %}
{% block page_subtitle %}Signed in as {{ app.user.email }}{% endblock %}

{% block body %}
    {% set input = 'mt-1.5 block w-full rounded-xl border border-ebony/15 bg-white/70 px-3.5 py-2.5 text-sm outline-none transition focus:border-honey focus:ring-2 focus:ring-honey/30' %}
    {% set label = 'block text-sm font-semibold' %}
    {% set error = 'mt-1 text-xs font-semibold text-red-700' %}
    {% set btn = 'inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey' %}

    <div class="grid gap-6 xl:grid-cols-2">
        {# ---------- Change your password ---------- #}
        <section class="rounded-2xl bg-parchment p-6 ring-1 ring-ebony/10 sm:p-8">
            <h2 class="font-display text-xl font-bold">Change your password</h2>
            <p class="mt-1 text-sm text-ebony/60">You stay signed in after changing it.</p>

            {{ form_start(passwordForm, {'attr': {'class': 'mt-5 space-y-4'}}) }}
                <div>
                    {{ form_label(passwordForm.currentPassword, 'Current password', {'label_attr': {'class': label}}) }}
                    {{ form_widget(passwordForm.currentPassword, {'attr': {'class': input}}) }}
                    <div class="{{ error }}">{{ form_errors(passwordForm.currentPassword) }}</div>
                </div>
                <div>
                    {{ form_label(passwordForm.newPassword.first, 'New password', {'label_attr': {'class': label}}) }}
                    {{ form_widget(passwordForm.newPassword.first, {'attr': {'class': input, 'placeholder': 'At least 8 characters'}}) }}
                </div>
                <div>
                    {{ form_label(passwordForm.newPassword.second, 'Repeat new password', {'label_attr': {'class': label}}) }}
                    {{ form_widget(passwordForm.newPassword.second, {'attr': {'class': input}}) }}
                    <div class="{{ error }}">{{ form_errors(passwordForm.newPassword) }}{{ form_errors(passwordForm.newPassword.first) }}</div>
                </div>
                {{ form_rest(passwordForm) }}
                <div class="flex justify-end">
                    <button type="submit" class="{{ btn }} bg-honey text-white hover:bg-honey-deep">Update password</button>
                </div>
            {{ form_end(passwordForm) }}
        </section>

        {# ---------- Staff accounts ---------- #}
        <section class="rounded-2xl bg-parchment ring-1 ring-ebony/10">
            <div class="flex flex-wrap items-center justify-between gap-3 px-6 pb-4 pt-6 sm:px-8">
                <div>
                    <h2 class="font-display text-xl font-bold">Staff accounts</h2>
                    <p class="mt-1 text-sm text-ebony/60">Everyone who can open this admin panel.</p>
                </div>
                <a href="{{ path('app_register') }}" class="{{ btn }} bg-honey text-white hover:bg-honey-deep">
                    {{ icons.icon('plus', 'h-4 w-4') }} Add staff account
                </a>
            </div>
            <ul class="divide-y divide-ebony/10 border-t border-ebony/10">
                {% for member in staff %}
                    <li class="flex items-center gap-3 px-6 py-3 sm:px-8">
                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-honey font-display text-sm font-bold text-white">{{ member.initial }}</span>
                        <div class="min-w-0 flex-1">
                            <p class="font-semibold">{{ member.name }}{% if member == app.user %} <span class="text-xs font-semibold text-honey-deep">(you)</span>{% endif %}</p>
                            <p class="truncate text-xs text-ebony/55">{{ member.email }}</p>
                        </div>
                        <p class="text-xs text-ebony/55">Since {{ member.createdAt|date('M j, Y') }}</p>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>
{% endblock %}
