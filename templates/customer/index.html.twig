{% extends 'base.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Customers · Shan's Guitar Admin{% endblock %}

{% block page_title %}Customers{% endblock %}
{% block page_subtitle %}{{ rows|length }} {{ query ? 'found' : 'people signed up on the store' }}{% endblock %}

{% block body %}
    <section class="rounded-2xl bg-parchment ring-1 ring-ebony/10">
        <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-5">
            <p class="text-sm text-ebony/60">Totals don’t include cancelled orders.</p>
            <form method="get" action="{{ path('app_customer_index') }}" class="flex items-center gap-2">
                <label class="relative">
                    <span class="sr-only">Search customers</span>
                    <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-ebony/45">{{ icons.icon('search', 'h-4 w-4') }}</span>
                    <input type="search" name="q" value="{{ query }}" placeholder="Name, email or phone"
                           class="w-60 rounded-full border border-ebony/15 bg-white/70 py-2 pl-9 pr-4 text-sm outline-none focus:border-honey focus:ring-2 focus:ring-honey/30">
                </label>
                {% if query %}<a href="{{ path('app_customer_index') }}" class="text-sm font-semibold text-honey-deep underline-offset-4 hover:underline">Clear</a>{% endif %}
            </form>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[48rem] text-left text-sm">
                <thead class="border-y border-ebony/10 text-xs font-semibold text-ebony/55">
                    <tr>
                        <th scope="col" class="px-6 py-3">Customer</th>
                        <th scope="col" class="px-3 py-3">Phone</th>
                        <th scope="col" class="px-3 py-3">Member since</th>
                        <th scope="col" class="px-3 py-3 text-right">Orders</th>
                        <th scope="col" class="px-3 py-3 text-right">Total spent</th>
                        <th scope="col" class="px-3 py-3">Last order</th>
                        <th scope="col" class="px-6 py-3"><span class="sr-only">Details</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ebony/10">
                    {% for row in rows %}
                        {% set c = row.customer %}
                        <tr>
                            <td class="px-6 py-3">
                                <div class="flex items-center gap-3">
                                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-sand font-display text-sm font-bold text-honey-deep">{{ c.initial }}</span>
                                    <div>
                                        <a href="{{ path('app_customer_show', {id: c.id}) }}" class="font-semibold underline-offset-4 hover:underline">{{ c.name }}</a>
                                        <p class="text-xs text-ebony/55">{{ c.email }}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-3 py-3 text-ebony/75">{{ c.phone ?? '—' }}</td>
                            <td class="px-3 py-3 text-ebony/75">{{ c.createdAt|date('M j, Y') }}</td>
                            <td class="px-3 py-3 text-right tabular-nums">{{ row.orders }}</td>
                            <td class="px-3 py-3 text-right font-semibold tabular-nums">₱{{ row.spent|number_format(2) }}</td>
                            <td class="px-3 py-3 text-ebony/75">{{ row.lastOrder ? row.lastOrder|date('M j, Y') : 'Never' }}</td>
                            <td class="px-6 py-3 text-right">
                                <a href="{{ path('app_customer_show', {id: c.id}) }}" class="inline-flex items-center rounded-full px-3.5 py-1.5 text-xs font-bold ring-1 ring-ebony/20 hover:bg-sand">Details</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="px-6 py-10 text-center text-ebony/60">{{ query ? 'No customer matches your search.' : 'No customers yet.' }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
