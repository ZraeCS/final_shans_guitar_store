{% extends 'base.html.twig' %}
{% import 'partials/orders.html.twig' as ui %}

{% block title %}GCash Payments · Shan's Guitar Admin{% endblock %}

{% block page_title %}GCash Payments{% endblock %}
{% block page_subtitle %}
    {{ to_verify|length == 0 ? 'Nothing to check right now' : (to_verify|length == 1 ? '1 payment to check' : to_verify|length ~ ' payments to check') }}
{% endblock %}

{% block body %}
    {# ---------- How it works (short, for whoever is on duty) ---------- #}
    <p class="mb-5 max-w-3xl text-sm text-ebony/70">
        Customers who pay with GCash type their reference number at checkout.
        For each payment below, open the GCash app, find a payment with the same
        <strong>reference number</strong> and <strong>amount</strong>, then press Verify.
        If there's no such payment, press Reject: the order is cancelled and its items go back into stock.
    </p>

    {# ---------- Queue ---------- #}
    <section aria-labelledby="queue-title">
        <h2 id="queue-title" class="sr-only">Payments to check</h2>
        {% for order in to_verify %}
            <article class="mb-4 grid gap-4 rounded-2xl bg-parchment p-5 ring-1 ring-ebony/10 md:grid-cols-[1fr_auto] md:items-center">
                <div class="grid gap-4 sm:grid-cols-3">
                    <div>
                        <p class="text-xs font-semibold text-ebony/55">Reference number</p>
                        <p class="mt-1 font-display text-2xl font-bold tracking-wide">{{ order.paymentRef ?? '—' }}</p>
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-ebony/55">Amount</p>
                        <p class="mt-1 font-display text-2xl font-bold tabular-nums">₱{{ order.total|number_format(2) }}</p>
                    </div>
                    <div class="text-sm">
                        <p class="text-xs font-semibold text-ebony/55">Order</p>
                        <p class="mt-1"><a href="{{ path('app_order_show', {id: order.id}) }}" class="font-bold underline-offset-4 hover:underline">#{{ order.id }}</a> · {{ order.customer.name }}</p>
                        <p class="text-ebony/60">{{ ui.items_summary(order) }}</p>
                        <p class="text-xs text-ebony/55">Submitted {{ order.createdAt|date('M j, g:i A') }}</p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2 md:justify-end">
                    {{ ui.actions(order, 'gcash') }}
                    {{ ui.cancel_button(order, 'gcash', 'Reject') }}
                </div>
            </article>
        {% else %}
            <div class="rounded-2xl bg-parchment px-6 py-10 text-center text-ebony/60 ring-1 ring-ebony/10">
                All GCash payments are checked. New ones appear here as soon as a customer pays.
            </div>
        {% endfor %}
    </section>

    {# ---------- Recently verified ---------- #}
    <section class="mt-8 rounded-2xl bg-parchment ring-1 ring-ebony/10">
        <h2 class="px-6 py-5 font-display text-xl font-bold">Recently verified</h2>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[44rem] text-left text-sm">
                <thead class="border-y border-ebony/10 text-xs font-semibold text-ebony/55">
                    <tr>
                        <th scope="col" class="px-6 py-3">Order</th>
                        <th scope="col" class="px-3 py-3">Reference</th>
                        <th scope="col" class="px-3 py-3 text-right">Amount</th>
                        <th scope="col" class="px-3 py-3">Verified by</th>
                        <th scope="col" class="px-6 py-3">Status now</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ebony/10">
                    {% for order in recently_verified %}
                        <tr>
                            <td class="px-6 py-3"><a href="{{ path('app_order_show', {id: order.id}) }}" class="font-bold underline-offset-4 hover:underline">#{{ order.id }}</a> <span class="text-ebony/60">· {{ order.customer.name }}</span></td>
                            <td class="px-3 py-3 font-semibold tracking-wide">{{ order.paymentRef }}</td>
                            <td class="px-3 py-3 text-right tabular-nums">₱{{ order.total|number_format(2) }}</td>
                            <td class="px-3 py-3">{{ order.paymentVerifiedBy ? order.paymentVerifiedBy.name : '—' }} <span class="block text-xs text-ebony/55">{{ order.paymentVerifiedAt|date('M j, g:i A') }}</span></td>
                            <td class="px-6 py-3">{{ ui.status_badge(order.status) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="px-6 py-8 text-center text-ebony/60">No verified GCash payments yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
