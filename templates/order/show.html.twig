{% extends 'base.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/orders.html.twig' as ui %}

{% block title %}Order #{{ order.id }} · Shan's Guitar Admin{% endblock %}

{% block page_title %}Order #{{ order.id }}{% endblock %}
{% block page_subtitle %}Placed {{ order.createdAt|date('l, F j, Y \\a\\t g:i A') }}{% endblock %}

{% block body %}
    {% set card = 'rounded-2xl bg-parchment ring-1 ring-ebony/10' %}
    {% set steps = ['pending', 'confirmed', 'shipped', 'delivered'] %}
    {% set step_labels = {pending: 'Placed', confirmed: 'Confirmed', shipped: 'Shipped', delivered: 'Delivered'} %}
    {% set current_step = order.status.value == 'cancelled' ? -1 : steps|keys|filter(i => steps[i] == order.status.value)|first %}

    <a href="{{ path('app_order_index') }}" class="mb-4 inline-flex items-center gap-1.5 text-sm font-semibold text-honey-deep underline-offset-4 hover:underline">
        {{ icons.icon('back', 'h-4 w-4') }} Back to Orders
    </a>

    <div class="grid gap-6 xl:grid-cols-[1fr_22rem]">
        <div class="space-y-6">
            {# ---------- Progress ---------- #}
            <section class="{{ card }} p-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h2 class="font-display text-xl font-bold">Progress</h2>
                    {{ ui.status_badge(order.status) }}
                </div>

                {% if order.status.value == 'cancelled' %}
                    <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                        This order was cancelled{% if order.statusUpdatedAt %} on {{ order.statusUpdatedAt|date('M j, Y \\a\\t g:i A') }}{% endif %}. Its items were returned to stock.
                    </p>
                {% else %}
                    <ol class="mt-5 grid grid-cols-4 gap-2">
                        {% for step in steps %}
                            {% set done = loop.index0 <= current_step %}
                            <li class="text-center">
                                <div class="mx-auto h-1.5 rounded-full {{ done ? 'bg-honey' : 'bg-ebony/10' }}"></div>
                                <p class="mt-2 text-xs font-bold {{ done ? 'text-ebony' : 'text-ebony/40' }}">{{ step_labels[step] }}</p>
                            </li>
                        {% endfor %}
                    </ol>
                    {% if order.statusUpdatedAt %}
                        <p class="mt-3 text-xs text-ebony/55">Last update {{ order.statusUpdatedAt|date('M j, Y \\a\\t g:i A') }}</p>
                    {% endif %}
                {% endif %}
            </section>

            {# ---------- Items ---------- #}
            <section class="{{ card }}">
                <h2 class="px-6 pt-5 font-display text-xl font-bold">Items</h2>
                <div class="overflow-x-auto">
                    <table class="mt-3 w-full min-w-[36rem] text-left text-sm">
                        <thead class="border-y border-ebony/10 text-xs font-semibold text-ebony/55">
                            <tr>
                                <th scope="col" class="px-6 py-3">Product</th>
                                <th scope="col" class="px-3 py-3 text-right">Qty</th>
                                <th scope="col" class="px-3 py-3 text-right">Price</th>
                                <th scope="col" class="px-6 py-3 text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-ebony/10">
                            {% for item in order.items %}
                                <tr>
                                    <td class="px-6 py-3">
                                        <div class="flex items-center gap-3">
                                            <div class="grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-lg bg-white ring-1 ring-ebony/10">
                                                {% if item.guitar.image %}
                                                    <img src="{{ store_url(item.guitar.image) }}" alt="" class="h-full w-full object-contain">
                                                {% else %}
                                                    <span class="text-ebony/30">{{ icons.icon('image', 'h-4 w-4') }}</span>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <p class="font-semibold">{{ item.guitar.name }}</p>
                                                <p class="text-xs text-ebony/55">{{ item.guitar.itemCode }}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-3 py-3 text-right tabular-nums">{{ item.quantity }}</td>
                                    <td class="px-3 py-3 text-right tabular-nums">₱{{ item.unitPrice|number_format(2) }}</td>
                                    <td class="px-6 py-3 text-right font-semibold tabular-nums">₱{{ item.subtotal|number_format(2) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr class="border-t border-ebony/10">
                                <td colspan="3" class="px-6 py-4 text-right font-semibold">Total</td>
                                <td class="px-6 py-4 text-right font-display text-xl font-bold tabular-nums">₱{{ order.total|number_format(2) }}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        </div>

        <div class="space-y-6">
            {# ---------- What to do next ---------- #}
            <section class="{{ card }} p-6">
                <h2 class="font-display text-xl font-bold">Next step</h2>
                {% if next_statuses is empty and not order.needsGcashVerification %}
                    <p class="mt-2 text-sm text-ebony/60">Nothing left to do: this order is {{ order.status.label|lower }}.</p>
                {% else %}
                    {% if order.needsGcashVerification %}
                        <p class="mt-2 text-sm text-ebony/70">Open the GCash app and check that ₱{{ order.total|number_format(2) }} arrived with reference <strong>{{ order.paymentRef }}</strong>.</p>
                    {% endif %}
                    <div class="mt-4 flex flex-wrap justify-start gap-2 [&>div]:justify-start">
                        {{ ui.actions(order, 'show') }}
                        {% if 'cancelled' in next_statuses|map(s => s.value) %}
                            {{ ui.cancel_button(order, 'show', order.needsGcashVerification ? 'Reject' : 'Cancel order') }}
                        {% endif %}
                    </div>
                {% endif %}
            </section>

            {# ---------- Customer & delivery ---------- #}
            <section class="{{ card }} p-6 text-sm">
                <h2 class="font-display text-xl font-bold">Customer</h2>
                <dl class="mt-3 space-y-3">
                    <div><dt class="text-xs font-semibold text-ebony/55">Account</dt><dd>{{ order.customer.name }} · {{ order.customer.email }}</dd></div>
                    <div><dt class="text-xs font-semibold text-ebony/55">Name on order</dt><dd>{{ order.fullname }}</dd></div>
                    <div><dt class="text-xs font-semibold text-ebony/55">Phone</dt><dd>{{ order.phone }}</dd></div>
                    <div><dt class="text-xs font-semibold text-ebony/55">{{ order.fulfillment == 'pickup' ? 'Pickup' : 'Deliver to' }}</dt><dd>{{ order.address }}, {{ order.city }}</dd></div>
                    <div><dt class="text-xs font-semibold text-ebony/55">Notes</dt><dd>{{ order.notes ?? '—' }}</dd></div>
                </dl>
            </section>

            {# ---------- Payment ---------- #}
            <section class="{{ card }} p-6 text-sm">
                <h2 class="font-display text-xl font-bold">Payment</h2>
                <dl class="mt-3 space-y-3">
                    <div><dt class="text-xs font-semibold text-ebony/55">Method</dt><dd>{{ order.paymentMethod.label }}</dd></div>
                    {% if order.gcash %}
                        <div><dt class="text-xs font-semibold text-ebony/55">GCash reference</dt><dd class="font-semibold tracking-wide">{{ order.paymentRef ?? '—' }}</dd></div>
                        <div>
                            <dt class="text-xs font-semibold text-ebony/55">Verification</dt>
                            <dd>
                                {% if order.paymentVerified %}
                                    <span class="font-semibold text-green-800">Verified</span>
                                    {{ order.paymentVerifiedBy ? 'by ' ~ order.paymentVerifiedBy.name }} on {{ order.paymentVerifiedAt|date('M j, Y \\a\\t g:i A') }}
                                {% else %}
                                    <span class="font-semibold text-honey-deep">Not verified yet</span>
                                {% endif %}
                            </dd>
                        </div>
                    {% endif %}
                </dl>
            </section>
        </div>
    </div>
{% endblock %}
